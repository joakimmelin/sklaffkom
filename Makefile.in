#
# Makefile for SklaffKOM
#

SKLAFFUSER=sklaff
SKLAFFBIN=/usr/local/bin
SKLAFFDIR=/usr/local/sklaff

#
# Defaults for an unconfigured Linux build.
# Run ./configure for automatic platform detection.
#

SKLAFFSYS=@SKLAFFSYS@
CC=@CC@

SKLAFFFLAGS = -DHAVE_CONFIG_H -D$(SKLAFFSYS) -DSKLAFFDIR=\"$(SKLAFFDIR)\" -DSKLAFFBIN=\"$(SKLAFFBIN)\"
CFLAGS = $(SKLAFFFLAGS) -O2 -g -pipe -Wall

LIBS=-lsklaff @LIBS@

# Optional InterBBS Oneliner.  The importer has no external dependencies.
ENABLE_IBOL=@ENABLE_IBOL@
IBOL_BUILD_TARGET=@IBOL_BUILD_TARGET@

# Bundled SklaffKOM Frotz.  These values are generated by ./configure.
WITH_FROTZ=@WITH_FROTZ@
FROTZ_BUILD_TARGET=@FROTZ_BUILD_TARGET@
FROTZ_CLEAN_TARGET=@FROTZ_CLEAN_TARGET@
FROTZ_DIR=vendor/frotz
FROTZ_INSTALL=$(SKLAFFDIR)/libexec/frotz

# Optional BBSLink client. Never include libcurl/libcrypto in the core link.
ENABLE_BBSLINK=@ENABLE_BBSLINK@
BBSLINK_CFLAGS=@BBSLINK_CFLAGS@
BBSLINK_LIBS=@BBSLINK_LIBS@
BBSLINK_BUILD_TARGET=$(if $(filter 1,$(ENABLE_BBSLINK)),bbslink_client,)
BBSLINK_INSTALL=$(SKLAFFDIR)/libexec/bbslink_client

# Vendored CP437 translation wrapper, built only with --enable-bbslink.
# Keep the original source under vendor/; put generated binaries under build/.
CP437_SOURCE=vendor/cp437/cp437.c
CP437_BUILD=build/cp437/cp437
CP437_BUILD_TARGET=$(if $(filter 1,$(ENABLE_BBSLINK)),$(CP437_BUILD),)
CP437_CFLAGS=@CP437_CFLAGS@
CP437_LIBS=@CP437_LIBS@
CP437_INSTALL=$(SKLAFFDIR)/libexec/cp437

# Bundled lrzsz 0.13.1; configured and compiled in a separate build directory.
ZMODEM_BUILD_TARGET=@ZMODEM_BUILD_TARGET@
ZMODEM_CPPFLAGS=@ZMODEM_CPPFLAGS@
LRZSZ_SOURCE=vendor/lrzsz
LRZSZ_BUILD=build/lrzsz

# Add the optional client to existing target lists without modifying Frotz/ZMODEM.
all: $(BBSLINK_BUILD_TARGET) $(CP437_BUILD_TARGET)
install: $(BBSLINK_BUILD_TARGET) $(CP437_BUILD_TARGET)
clean: clean-bbslink
.PHONY: clean-bbslink
clean-bbslink:
	-rm -f bbslink_client
	-rm -rf build/cp437

#
# Change nothing below this line
#

OBJS = \
	admin.o \
	bbslink.o \
	buf.o \
	commands.o \
	command_list.o \
	conf.o \
	confxtra.o \
	displaytime.o \
	edit.o \
	external.o \
	file.o \
	footnote.o \
	flag.o \
	iboldb.o \
	ibolview.o \
	log.o \
	msg.o \
	newsparse.o \
	parse.o\
	plan.o\
	praise.o\
	survey.o \
	text.o \
	user.o \
	utf.o \
	version.o
KOMOBJ=sklaffkom.o
ADMOBJ=sklaffadm.o
WHOOBJ=sklaffwho.o
ACCTOBJ=sklaffacct.o
MTOSSOBJ=mailtoss.o mailbody.o mailparse.o
NTOSSOBJ=newstoss.o
FTNTOBJ=ftntoss.o ftnconfig.o ftnmsg.o ftnnetmail.o utf.o version.o
SURVREPOBJ=survreport.o
FTCOBJ=forwardtoconf.o
FTYOBJ=forwardtoyell.o
IBOLIMPORTOBJ=ibolimport.o ibol.o iboldb.o ftnmsg.o
IBOLMSGDUMPOBJ=ibolmsgdump.o ibol.o ftnmsg.o

SKLAFFLIB=lib/libsklaff.a

#newstoss was missing below, added 2025-07-14
all: $(SKLAFFLIB) sklaffkom sklaffadm sklaffacct newstoss mailtoss ftntoss survreport sklaffwho $(FROTZ_BUILD_TARGET) $(ZMODEM_BUILD_TARGET) $(IBOL_BUILD_TARGET)

# config.h is generated by ./configure.  Rebuild all top-level objects when
# configuration options or detected dependencies change.
$(OBJS) $(KOMOBJ) $(ADMOBJ) $(WHOOBJ) $(ACCTOBJ) $(MTOSSOBJ) $(NTOSSOBJ) \
	$(FTNTOBJ) $(SURVREPOBJ) $(FTCOBJ) $(FTYOBJ) $(IBOLIMPORTOBJ) \
	$(IBOLMSGDUMPOBJ): config.h

$(OBJS): sklaff.h ext_globals.h struct.h lang.h
$(KOMOBJ): sklaff.h globals.h struct.h lang.h
$(ADMOBJ): sklaff.h globals.h struct.h lang.h
$(WHOOBJ): sklaff.h globals.h struct.h lang.h
$(ACCTOBJ): sklaff.h globals.h struct.h lang.h
$(MTOSSOBJ): sklaff.h globals.h struct.h lang.h
$(NTOSSOBJ): sklaff.h globals.h struct.h lang.h
$(FTNTOBJ): sklaff.h struct.h ftnmsg.h
$(SURVREPOBJ): sklaff.h globals.h struct.h lang.h
$(FTCOBJ): sklaff.h globals.h struct.h lang.h
$(FTYOBJ): sklaff.h globals.h struct.h lang.h

ibolimport.o: ftnmsg.h ibol.h iboldb.h
ibol.o: ibol.h ftnmsg.h
iboldb.o: iboldb.h

# The CP437 wrapper depends only on the platform's PTY and iconv libraries.
# Do not call upstream Makefile: it hardcodes gcc and platform link flags.
$(CP437_BUILD): $(CP437_SOURCE)
	mkdir -p build/cp437
	$(CC) $(CFLAGS) $(CP437_CFLAGS) -o "$@" "$<" $(CP437_LIBS)

# BBSLink links separately, without adding dependencies to the BBS core.
bbslink_client: bbslink_client.c config.h
	$(CC) $(CFLAGS) $(BBSLINK_CFLAGS) -o $@ bbslink_client.c $(BBSLINK_LIBS)

sklaffkom: $(SKLAFFLIB) $(KOMOBJ) $(OBJS)
	$(CC) -g -o sklaffkom $(KOMOBJ) $(OBJS) -Llib $(LIBS)
	#chmod u+s sklaffkom
	#chown $(SKLAFFUSER) sklaffkom

sklaffadm: $(SKLAFFLIB) $(ADMOBJ) $(OBJS)
	$(CC) -o sklaffadm $(ADMOBJ) $(OBJS) -Llib $(LIBS)
	strip sklaffadm
	chmod og-rwx sklaffadm

sklaffwho: $(SKLAFFLIB) $(WHOOBJ) $(OBJS)
	$(CC) -o sklaffwho $(WHOOBJ) $(OBJS) -Llib $(LIBS)
	strip sklaffwho
	#chmod u+s sklaffwho

sklaffacct: $(SKLAFFLIB) $(ACCTOBJ) $(OBJS)
	$(CC) -o sklaffacct $(ACCTOBJ) $(OBJS) -Llib $(LIBS)
	strip sklaffacct
	#chmod u+s sklaffacct

mailtoss: $(SKLAFFLIB) $(MTOSSOBJ) $(OBJS)
	$(CC) -o mailtoss $(MTOSSOBJ) $(OBJS) -Llib $(LIBS)
#	strip mailtoss

newstoss: $(SKLAFFLIB) $(NTOSSOBJ) $(OBJS)
	$(CC) -o newstoss $(NTOSSOBJ) $(OBJS) -Llib $(LIBS)
#	strip newstoss

ftntoss: $(SKLAFFLIB) $(FTNTOBJ)
	$(CC) -o ftntoss $(FTNTOBJ) -Llib $(LIBS)
#	strip ftntoss

survreport: $(SKLAFFLIB) $(SURVREPOBJ) $(OBJS)
	$(CC) -o survreport $(SURVREPOBJ) $(OBJS) -Llib $(LIBS)
	strip survreport

forwardtoconf: $(SKLAFFLIB) $(FTCOBJ) $(OBJS)
	$(CC) -o forwardtoconf $(FTCOBJ) $(OBJS) -Llib $(LIBS)
#	strip forwardtoconf

forwardtoyell: $(SKLAFFLIB) $(FTYOBJ) $(OBJS)
	$(CC) -o forwardtoyell $(FTYOBJ) $(OBJS) -Llib $(LIBS)
	strip forwardtoyell

ibolimport: $(IBOLIMPORTOBJ)
	$(CC) -o ibolimport $(IBOLIMPORTOBJ)

ibolmsgdump: $(IBOLMSGDUMPOBJ)
	$(CC) -o ibolmsgdump $(IBOLMSGDUMPOBJ)

version.c:
	@./version.sh

$(SKLAFFLIB):
	(cd lib; $(MAKE) CC=$(CC) CFLAGS='$(CFLAGS) -I..')

.PHONY: frotz clean-frotz zmodem clean-zmodem upgrade

frotz:
	$(MAKE) -C $(FROTZ_DIR) CC="$(CC)" frotz

clean-frotz:
	$(MAKE) -C $(FROTZ_DIR) distclean

# Autotools VPATH build: don't generate files inside vendor/lrzsz.
$(LRZSZ_BUILD)/Makefile: $(LRZSZ_SOURCE)/configure
	mkdir -p "$(LRZSZ_BUILD)"
	cd "$(LRZSZ_BUILD)" && CC="$(CC)" CPPFLAGS="$(ZMODEM_CPPFLAGS)" \
		../../vendor/lrzsz/configure --disable-nls

zmodem: $(LRZSZ_BUILD)/Makefile
	$(MAKE) -C "$(LRZSZ_BUILD)/src" lrz lsz

clean-zmodem:
	rm -rf "$(LRZSZ_BUILD)"

install: sklaffkom sklaffadm sklaffacct survreport sklaffwho newstoss mailtoss ftntoss $(IBOL_BUILD_TARGET) $(FROTZ_BUILD_TARGET) $(ZMODEM_BUILD_TARGET)
	@echo Making libraries
	-mkdir $(SKLAFFDIR)
	-mkdir $(SKLAFFDIR)/etc
	-mkdir $(SKLAFFDIR)/log
	-mkdir $(SKLAFFBIN)
	@echo Installing SklaffKOM
	-mv $(SKLAFFBIN)/sklaffkom $(SKLAFFBIN)/sklaffkom.old
	cp sklaffkom sklaffadm sklaffwho sklaffacct $(SKLAFFBIN)/
	cp survreport $(SKLAFFBIN)/srep
	-chown $(SKLAFFUSER) $(SKLAFFBIN)/sklaffkom $(SKLAFFBIN)/sklaffadm $(SKLAFFBIN)/sklaffwho \
		$(SKLAFFBIN)/sklaffacct $(SKLAFFDIR)/log
	-chown root   $(SKLAFFBIN)/srep
	chmod u+s $(SKLAFFBIN)/sklaffkom $(SKLAFFBIN)/sklaffacct $(SKLAFFBIN)/sklaffwho
	chmod og-rxw $(SKLAFFBIN)/sklaffadm
	-chmod 4755   $(SKLAFFBIN)/srep
	cp newstoss mailtoss ftntoss $(SKLAFFDIR)/etc
	cp newstoss $(SKLAFFDIR)/etc/ntoss
	cp mailtoss $(SKLAFFDIR)/etc/mtoss
	# Better copy mailtoss and newstoss to sklaffbin also
	cp mailtoss $(SKLAFFBIN)
	cp newstoss $(SKLAFFBIN)
	cp ftntoss $(SKLAFFBIN)
	@if [ "$(ENABLE_IBOL)" = "1" ]; then \
		echo "Installing IBOL importer"; \
		install -m 700 ibolimport "$(SKLAFFDIR)/etc/ibolimport"; \
		chown root "$(SKLAFFDIR)/etc/ibolimport"; \
		install -m 755 ibolimport "$(SKLAFFBIN)/ibolimport"; \
	fi
	cp etc/ftnqueue-runner $(SKLAFFBIN)/ftnqueue-runner
	chown root $(SKLAFFBIN)/ftnqueue-runner
	chmod 755 $(SKLAFFBIN)/ftnqueue-runner
	-chown root $(SKLAFFDIR)/etc/newstoss $(SKLAFFDIR)/etc/ntoss $(SKLAFFDIR)/etc/mailtoss $(SKLAFFDIR)/etc/mtoss $(SKLAFFDIR)/etc/ftntoss
	-chmod og-rxw $(SKLAFFDIR)/etc/newstoss $(SKLAFFDIR)/etc/ntoss $(SKLAFFDIR)/etc/mailtoss $(SKLAFFDIR)/etc/mtoss $(SKLAFFDIR)/etc/ftntoss
	@if [ "$(WITH_FROTZ)" = "1" ]; then \
		echo "Installing bundled SklaffKOM Frotz"; \
		mkdir -p "$(SKLAFFDIR)/libexec"; \
		install -m 755 "$(FROTZ_DIR)/frotz" "$(FROTZ_INSTALL)"; \
	fi
	@if [ "$(ENABLE_BBSLINK)" = "1" ]; then \
		echo "Installing SklaffKOM BBSLink client"; \
		mkdir -p "$(SKLAFFDIR)/libexec" "$(SKLAFFDIR)/etc"; \
		install -m 755 bbslink_client "$(BBSLINK_INSTALL)"; \
		install -m 755 "$(CP437_BUILD)" "$(CP437_INSTALL)"; \
		mkdir -p "$(SKLAFFDIR)/licenses"; \
		install -m 644 vendor/cp437/COPYRIGHT "$(SKLAFFDIR)/licenses/cp437-COPYRIGHT"; \
		if [ ! -e "$(SKLAFFDIR)/etc/bbslink_credentials.example" ]; then \
			install -m 644 etc/bbslink_credentials.example "$(SKLAFFDIR)/etc/bbslink_credentials.example"; \
		fi; \
	fi
	@if [ "$(ZMODEM_BUILD_TARGET)" = "zmodem" ]; then \
		echo "Installing bundled lrzsz (lrz and lsz)"; \
		mkdir -p "$(SKLAFFDIR)/libexec"; \
		install -m 755 "$(LRZSZ_BUILD)/src/lrz" "$(SKLAFFDIR)/libexec/lrz"; \
		install -m 755 "$(LRZSZ_BUILD)/src/lsz" "$(SKLAFFDIR)/libexec/lsz"; \
	fi

# Upgrade data files in an existing installation without touching databases,
# users, mailboxes, conference data, local games, or other runtime data.
upgrade:
	@SKLAFFDIR="$(SKLAFFDIR)" SKLAFFUSER="$(SKLAFFUSER)" sh ./upgrade.sh

# WARNING: installdb creates a fresh data tree and removes existing data.
# Use "make upgrade" when upgrading an existing SklaffKOM installation.
installdb:
	@echo Installing datafiles
	-mkdir $(SKLAFFDIR)
	chown $(SKLAFFUSER) $(SKLAFFDIR)
	chmod og-rwx $(SKLAFFDIR)
	-rm -rf $(SKLAFFDIR)/db
	mkdir $(SKLAFFDIR)/db
	chown $(SKLAFFUSER) $(SKLAFFDIR)/db
	chmod og-rwx $(SKLAFFDIR)/db
	rm -rf $(SKLAFFDIR)/ftnqueue
	mkdir $(SKLAFFDIR)/ftnqueue
	chown $(SKLAFFUSER) $(SKLAFFDIR)/ftnqueue
	chmod og-rwx $(SKLAFFDIR)/ftnqueue
	mkdir $(SKLAFFDIR)/ftnqueue/tmp
	chown $(SKLAFFUSER) $(SKLAFFDIR)/ftnqueue/tmp
	chmod og-rwx $(SKLAFFDIR)/ftnqueue/tmp
	mkdir $(SKLAFFDIR)/ftnqueue/pending
	chown $(SKLAFFUSER) $(SKLAFFDIR)/ftnqueue/pending
	chmod og-rwx $(SKLAFFDIR)/ftnqueue/pending
	mkdir $(SKLAFFDIR)/ftnqueue/netmail
	chown $(SKLAFFUSER) $(SKLAFFDIR)/ftnqueue/netmail
	chmod og-rwx $(SKLAFFDIR)/ftnqueue/netmail
	mkdir $(SKLAFFDIR)/ftnqueue/netmail/tmp
	chown $(SKLAFFUSER) $(SKLAFFDIR)/ftnqueue/netmail/tmp
	chmod og-rwx $(SKLAFFDIR)/ftnqueue/netmail/tmp
	mkdir $(SKLAFFDIR)/ftnqueue/netmail/pending
	chown $(SKLAFFUSER) $(SKLAFFDIR)/ftnqueue/netmail/pending
	chmod og-rwx $(SKLAFFDIR)/ftnqueue/netmail/pending
	-rm -rf $(SKLAFFDIR)/user
	mkdir $(SKLAFFDIR)/user
	chown $(SKLAFFUSER) $(SKLAFFDIR)/user
	chmod og-rwx $(SKLAFFDIR)/user
	-rm -rf $(SKLAFFDIR)/mbox
	mkdir $(SKLAFFDIR)/mbox
	chown $(SKLAFFUSER) $(SKLAFFDIR)/mbox
	chmod og-rwx $(SKLAFFDIR)/mbox
	-rm -rf $(SKLAFFDIR)/files
	mkdir $(SKLAFFDIR)/files
	chown $(SKLAFFUSER) $(SKLAFFDIR)/files
	chmod og-rwx $(SKLAFFDIR)/files
	-rm -rf $(SKLAFFDIR)/etc
	mkdir $(SKLAFFDIR)/etc
	chown $(SKLAFFUSER) $(SKLAFFDIR)/etc
	chmod og-rwx $(SKLAFFDIR)/etc
	mkdir $(SKLAFFDIR)/etc/help.swe
	chown $(SKLAFFUSER) $(SKLAFFDIR)/etc/help.swe
	chmod og-rxw $(SKLAFFDIR)/etc/help.swe
	mkdir $(SKLAFFDIR)/etc/help.eng
	chown $(SKLAFFUSER) $(SKLAFFDIR)/etc/help.eng
	chmod og-rxw $(SKLAFFDIR)/etc/help.eng
	-cp etc/* $(SKLAFFDIR)/etc/
	cp etc/help.swe/* $(SKLAFFDIR)/etc/help.swe/
	cp etc/help.eng/* $(SKLAFFDIR)/etc/help.eng/
	chown $(SKLAFFUSER) $(SKLAFFDIR)/etc/*
	chown $(SKLAFFUSER) $(SKLAFFDIR)/etc/help.swe/*
	chown $(SKLAFFUSER) $(SKLAFFDIR)/etc/help.eng/*
	chmod og-rxw $(SKLAFFDIR)/etc/*
	chmod og-rxw $(SKLAFFDIR)/etc/help.swe/*
	chmod og-rxw $(SKLAFFDIR)/etc/help.eng/*
	# Door directories. Keep existing games/saves on repeated installdb runs.
	mkdir -p $(SKLAFFDIR)/doors/zmachine/data
	chown $(SKLAFFUSER) $(SKLAFFDIR)/doors
	chown $(SKLAFFUSER) $(SKLAFFDIR)/doors/zmachine
	chown $(SKLAFFUSER) $(SKLAFFDIR)/doors/zmachine/data
	chmod 755 $(SKLAFFDIR)/doors
	chmod 755 $(SKLAFFDIR)/doors/zmachine
	chmod 700 $(SKLAFFDIR)/doors/zmachine/data
	@story_src="games/zmachine/zork1.z3"; \
	story_dst="$(SKLAFFDIR)/doors/zmachine/zork1.z3"; \
	if [ ! -f "$$story_src" ]; then \
		echo "Error: bundled Zork I story file $$story_src is missing."; \
		exit 1; \
	fi; \
	if [ ! -e "$$story_dst" ]; then \
		echo "Installing bundled Zork I"; \
		install -m 644 "$$story_src" "$$story_dst"; \
		chown $(SKLAFFUSER) "$$story_dst"; \
	elif [ ! -f "$$story_dst" ]; then \
		echo "Error: $$story_dst exists but is not a regular file."; \
		exit 1; \
	elif ! cmp -s "$$story_src" "$$story_dst"; then \
		echo "Keeping existing $$story_dst (differs from bundled Zork I)."; \
	fi; \
	if cmp -s "$$story_src" "$$story_dst"; then \
		install -m 644 games/zmachine/LICENSE.zork1 "$(SKLAFFDIR)/doors/zmachine/LICENSE.zork1"; \
		install -m 644 games/zmachine/README.zork1 "$(SKLAFFDIR)/doors/zmachine/README.zork1"; \
		chown $(SKLAFFUSER) "$(SKLAFFDIR)/doors/zmachine/LICENSE.zork1" "$(SKLAFFDIR)/doors/zmachine/README.zork1"; \
	else \
		echo "Not replacing Zork I metadata because the installed story file differs."; \
	fi

clean: $(FROTZ_CLEAN_TARGET) clean-zmodem
	(cd lib; $(MAKE) clean)
	-rm -f *.o *.a \#* *~ core \
	    sklaffkom sklaffadm sklaffacct \
	    mailtoss newstoss ftntoss survreport sklaffwho \
	    ibolimport ibolmsgdump \
	    forwardtoconf forwardtoyell \
	    version.c

# distrib is rewritten 2025-08-16 by PL to work in our modern times

distrib:
	echo 0 > .compile
	@BASENAME=$$(basename "$$PWD"); \
	DISTDIR="./dist"; \
	LIST="/tmp/sklaff.$$"; \
	mkdir -p "$$DISTDIR"; \
	( \
	  command -v git >/dev/null 2>&1 || { \
	    echo "Error: git is required for make distrib."; \
	    exit 1; \
	  }; \
	  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { \
	    echo "Error: make distrib must be run from a Git working tree."; \
	    exit 1; \
	  }; \
	  echo "Updating version.c from version.sh..."; \
	  sh "version.sh" >/dev/null 2>&1 || { echo "version.sh failed!"; exit 1; }; \
	  git ls-files | while IFS= read -r FILE; do \
	    [ -f "$$FILE" ] && printf '%s\n' "$$FILE"; \
	  done > "$$LIST"; \
	  [ -s "$$LIST" ] || { \
	    echo "Error: no files found for distribution."; \
	    rm -f "$$LIST"; \
	    exit 1; \
	  }; \
	  RAWV=$$(sh "version.sh" -s 2>/dev/null | awk '{print $$NF}' || echo unknown); \
	  PRETTYV=$$(printf '%s' "$$RAWV" | sed -E 's/#.*//' | sed -E 's/\([^)]+\)//g' | sed -E 's/([0-9]+)\.([0-9]+)b([0-9]+)/\1.\2-beta\3/'); \
	  SAFEV=$$(printf '%s' "$$PRETTYV" | tr -cd 'A-Za-z0-9._+-'); \
	  PKG="sklaff-$${SAFEV}"; \
	  echo "Version string from version.sh: $$RAWV"; \
	  echo "Filename-safe version: $$SAFEV"; \
	  if command -v compress >/dev/null 2>&1; then \
	    tar -cf - --files-from "$$LIST" | compress > "$$DISTDIR/$$PKG.tz"; \
	  else \
	    echo "Note: 'compress' not found; skipping .tz"; \
	  fi; \
	  tar -cf - --files-from "$$LIST" | gzip -9c > "$$DISTDIR/$$PKG.tgz"; \
	  zip -q -@ "$$DISTDIR/$$PKG.zip" < "$$LIST"; \
	  rm -f "$$LIST"; \
	  echo "Done. Created files in $$DISTDIR:"; \
	  ls -l "$$DISTDIR"/$$PKG.* 2>/dev/null || true \
	)
