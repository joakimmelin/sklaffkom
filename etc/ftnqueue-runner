#!/bin/sh

SKLAFFDIR=/usr/local/sklaff
SKLAFFBIN=/usr/local/bin
QUEUE="$SKLAFFDIR/ftnqueue"
PENDING="$QUEUE/pending"
LOCK="$QUEUE/runner.lock"

if ! mkdir "$LOCK" 2>/dev/null; then
    exit 0
fi

trap 'rmdir "$LOCK"' EXIT HUP INT TERM

for job in "$PENDING"/*; do
    [ -f "$job" ] || continue

    #
    # IBOL jobs share the ordinary echomail queue, but are identified by
    # filename and contain a typed multi-line job rather than conf:text:time.
    #
    # modified on 2026-08-13, PL
    #
    case "${job##*/}" in
        @ibol.*)
            if "$SKLAFFBIN/ftntoss" --export-ibol-job "$job" >/dev/null 2>&1; then
                rm -f "$job"
            fi
            continue
            ;;
    esac

    IFS=: read conf_or_area textnum created < "$job" || continue

    case "$textnum" in
        ''|*[!0-9]*)
            mv "$job" "$job.bad" 2>/dev/null || rm -f "$job"
            continue
            ;;
    esac

    case "$conf_or_area" in
        ''|*[!0-9]*)
            #
            # Backward compatibility for queue jobs created before
            # conference ids replaced local conference names in the queue.
            # Old jobs could only contain the legacy safe area characters.
            #
            # modified on 2026-08-11, PL
            #
            case "$conf_or_area" in
                ''|*[!A-Za-z0-9_.-]*)
                    mv "$job" "$job.bad" 2>/dev/null || rm -f "$job"
                    continue
                    ;;
            esac

            if "$SKLAFFBIN/ftntoss" --export-one "$conf_or_area" "$textnum" >/dev/null 2>&1; then
                rm -f "$job"
            fi
            ;;
        0)
            mv "$job" "$job.bad" 2>/dev/null || rm -f "$job"
            ;;
        *)
            if "$SKLAFFBIN/ftntoss" --export-one-conf "$conf_or_area" "$textnum" >/dev/null 2>&1; then
                rm -f "$job"
            fi
            ;;
    esac
done

NETMAIL_PENDING="$QUEUE/netmail/pending"

for job in "$NETMAIL_PENDING"/*; do
    [ -f "$job" ] || continue

    if "$SKLAFFBIN/ftntoss" --export-netmail-job "$job" >/dev/null 2>&1; then
        rm -f "$job"
    fi
done

exit 0
